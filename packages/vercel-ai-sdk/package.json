{
	"name": "@mondaydotcomorg/atp-vercel-sdk",
	"version": "0.23.1-rc-auto-referesh-token.0",
	"description": "Vercel AI SDK integration for Agent Tool Protocol.",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/mondaycom/agent-tool-protocol",
		"directory": "packages/vercel-ai-sdk"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "npx tsc --build tsconfig.json && tsup",
		"build:tsc": "tsc -p tsconfig.json",
		"dev": "tsc -p tsconfig.json --watch",
		"clean": "rm -rf dist *.tsbuildinfo",
		"test": "NODE_OPTIONS='--no-node-snapshot' jest --runInBand --forceExit --testTimeout=30000",
		"lint": "tsc --noEmit"
	},
	"keywords": [
		"agent",
		"protocol",
		"atp",
		"vercel",
		"ai-sdk",
		"ai",
		"llm"
	],
	"license": "MIT",
	"dependencies": {
		"@mondaydotcomorg/atp-client": "0.22.1-rc-auto-referesh-token.0",
		"@mondaydotcomorg/atp-protocol": "0.21.1-rc-auto-referesh-token.0"
	},
	"peerDependencies": {
		"ai": "^5.0.0",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@jest/globals": "^29.7.0",
		"@types/jest": "^29.5.11",
		"ai": "^5.0.0",
		"jest": "^29.7.0",
		"tsup": "^8.5.1",
		"typescript": "^5.3.3",
		"zod": "^3.25.0"
	}
}
