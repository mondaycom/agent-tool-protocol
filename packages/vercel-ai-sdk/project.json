{
	"name": "@mondaydotcomorg/atp-vercel-sdk",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/vercel-ai-sdk/src",
	"projectType": "library",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "tsc -p packages/vercel-ai-sdk/tsconfig.json"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc --noEmit -p packages/vercel-ai-sdk/tsconfig.json"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "cd packages/vercel-ai-sdk && NODE_OPTIONS='--no-node-snapshot' jest --runInBand --forceExit --testTimeout=30000"
			}
		}
	},
	"tags": ["type:library", "scope:integration"]
}

