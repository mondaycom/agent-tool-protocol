{
	"name": "@mondaydotcomorg/atp-langchain",
	"version": "0.26.0",
	"description": "LangChain integration for Agent Tool Protocol",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/mondaycom/agent-tool-protocol",
		"directory": "packages/langchain"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "npx tsc --build tsconfig.json && tsup",
		"build:tsc": "tsc -p tsconfig.json",
		"dev": "tsc -p tsconfig.json --watch",
		"clean": "rm -rf dist *.tsbuildinfo",
		"test": "vitest run",
		"lint": "tsc --noEmit"
	},
	"keywords": [
		"agent",
		"protocol",
		"atp",
		"langchain",
		"ai",
		"llm"
	],
	"license": "MIT",
	"dependencies": {
		"@langchain/core": "^1.1.5",
		"@mondaydotcomorg/atp-client": "0.24.0",
		"@mondaydotcomorg/atp-protocol": "0.22.3",
		"@mondaydotcomorg/atp-runtime": "0.22.3",
		"json-schema-to-zod": "^2.6.1",
		"langchain": "^1.2.0"
	},
	"peerDependencies": {
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"tsup": "^8.5.1",
		"typescript": "^5.3.3",
		"vitest": "^1.2.1",
		"zod": "^3.25.0"
	}
}
