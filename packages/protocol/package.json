{
	"name": "@mondaydotcomorg/atp-protocol",
	"version": "0.19.12",
	"description": "Core protocol types and interfaces for Agent Tool Protocol",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "npx tsc --build tsconfig.json && tsup",
		"build:tsc": "tsc -p tsconfig.json",
		"dev": "tsc -p tsconfig.json --watch",
		"clean": "rm -rf dist *.tsbuildinfo",
		"test": "vitest run",
		"lint": "tsc --noEmit"
	},
	"keywords": [
		"agent",
		"protocol",
		"atp",
		"types",
		"ai",
		"llm"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/mondaycom/agent-tool-protocol",
		"directory": "packages/protocol"
	},
	"license": "MIT",
	"dependencies": {
		"@mondaydotcomorg/atp-provenance": "0.19.11"
	},
	"peerDependencies": {
		"zod": "^3.25.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"tsup": "^8.5.1",
		"typescript": "^5.3.3",
		"vitest": "^1.2.1",
		"zod": "^3.25.0"
	}
}
