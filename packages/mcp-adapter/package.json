{
	"name": "@mondaydotcomorg/atp-mcp-adapter",
	"version": "0.21.7",
	"description": "MCP compatibility adapter for Agent Tool Protocol",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/mondaycom/agent-tool-protocol",
		"directory": "packages/mcp-adapter"
	},
	"files": [
		"dist",
		"src"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "npx tsc --build tsconfig.json && tsup",
		"build:tsc": "tsc -p tsconfig.json",
		"dev": "tsc -p tsconfig.json --watch",
		"clean": "rm -rf dist *.tsbuildinfo",
		"test": "vitest run",
		"lint": "tsc --noEmit"
	},
	"keywords": [
		"agent",
		"protocol",
		"atp",
		"mcp",
		"adapter",
		"ai",
		"llm"
	],
	"license": "MIT",
	"dependencies": {
		"@mondaydotcomorg/atp-protocol": "0.19.22",
		"@mondaydotcomorg/atp-server": "0.21.6"
	},
	"peerDependencies": {
		"@modelcontextprotocol/sdk": ">=0.5.0",
		"zod": "^3.25.0"
	},
	"peerDependenciesMeta": {
		"@modelcontextprotocol/sdk": {
			"optional": true
		}
	},
	"devDependencies": {
		"@modelcontextprotocol/sdk": "^1.23.0",
		"tsup": "^8.5.1",
		"typescript": "^5.3.3",
		"vitest": "^1.2.1",
		"zod": "^3.25.0"
	}
}
