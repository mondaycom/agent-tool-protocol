{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"composite": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist", "**/__tests__", "**/*.test.ts", "**/*.spec.ts"],
	"references": [{ "path": "../protocol" }, { "path": "../provenance" }, { "path": "../runtime" }]
}
