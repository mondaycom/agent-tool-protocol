{
	"name": "@mondaydotcomorg/atp-engine",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/engine/src",
	"projectType": "library",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc",
				"cwd": "packages/engine"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "NODE_OPTIONS='--no-node-snapshot --experimental-vm-modules' jest",
				"cwd": "packages/engine"
			}
		},
		"clean": {
			"executor": "nx:run-commands",
			"options": {
				"command": "rm -rf dist",
				"cwd": "packages/engine"
			}
		}
	},
	"tags": ["type:library", "scope:engine"]
}

