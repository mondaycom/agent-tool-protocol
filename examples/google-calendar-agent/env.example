# OpenAI API Key (required for LangChain agent)
OPENAI_API_KEY=your_openai_api_key_here

# ATP Server Configuration
ATP_SERVER_URL=http://localhost:3334
ATP_AUTH_TOKEN=calendar-demo-token
ATP_JWT_SECRET=your-jwt-secret-here-generate-with-openssl-rand-base64-32

# Google OAuth Credentials
# Download from Google Cloud Console -> APIs & Services -> Credentials
# Create OAuth 2.0 Client ID -> Desktop App
GOOGLE_OAUTH_CREDENTIALS=/path/to/your/gcp-oauth.keys.json

# Optional: Custom token storage path
# GOOGLE_CALENDAR_MCP_TOKEN_PATH=/path/to/token/storage

