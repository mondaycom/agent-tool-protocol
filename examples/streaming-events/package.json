		"@mondaydotcomorg/atp-client": "workspace:*",
		"@mondaydotcomorg/atp-langchain": "workspace:*",
		"@mondaydotcomorg/atp-protocol": "workspace:*",
		"@mondaydotcomorg/atp-server": "workspace:*",
		"@mondaydotcomorg/atp-vercel-sdk": "workspace:*",
		"ai": "^5.0.0",
		"dotenv": "^16.4.5",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
